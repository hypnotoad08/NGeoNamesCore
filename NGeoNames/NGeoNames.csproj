<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0</TargetFrameworks>
		<Authors>Hypnotoad08</Authors>
		<Company>Hypnotoad08</Company>
		<PackageId>NGeoNamesCore</PackageId>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<Product>NGeoNamesCore</Product>
		<Copyright>(C) 2026 Hypnotoad08</Copyright>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageProjectUrl>https://github.com/Hypnotoad08/NGeoNamesCore</PackageProjectUrl>
		<PackageTags>reverse-geocoding geocoding geocode reverse-geocode geocoder reverse-geocoder maps geonames performance async cancellation</PackageTags>
		<PackageReleaseNotes>v1.7.0: Major performance improvements - Added CancellationToken support, Memory/Span optimizations (32% faster, 61% less memory), and IHttpClientFactory integration. Minor breaking change: Removed fake async methods from ReverseGeoCode (use synchronous methods instead).</PackageReleaseNotes>
		<Description>High-performance library for downloading, parsing, and utilizing GeoNames.org data. Features async/await with CancellationToken support, Memory/Span optimizations for minimal allocations, and proper HttpClient management. Supports reverse geocoding, spatial searches, and file I/O operations. .NET 8 compatible.</Description>
		<PackageIconUrl>https://raw.githubusercontent.com/Hypnotoad08/NGeoNamesCore/main/icon.png</PackageIconUrl>
		<Version>1.7.0</Version>
		<Title>NGeoNamesCore</Title>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<RepositoryUrl>https://github.com/Hypnotoad08/NGeoNamesCore</RepositoryUrl>
		<RepositoryType>Git</RepositoryType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>TRACE;RELEASE;NETSTANDARD2_0</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net45|AnyCPU'">
		<DocumentationFile>bin\Release\net45\NGeoNamesCore.xml</DocumentationFile>
	</PropertyGroup>
	<ItemGroup>
	  <None Include="..\icon.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="KdTree" Version="1.4.1" />
	</ItemGroup>
</Project>
